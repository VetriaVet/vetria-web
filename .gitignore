# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

vetria-proto/

# Referências locais de design (protótipos HTML, zips, visualizadores).
# NÃO vão pra produção, mas NÃO devem ser apagadas — são peças-base pra criar
# o design das telas. Ficam só no disco local.
/*.html
/*.zip

# Claude Code
# Config local (permissões da máquina) fica FORA do repo.
# Os agentes do projeto são VERSIONADOS: precisam funcionar em qualquer
# sessão e em qualquer máquina, não só nesta. Ver docs/AGENTES.md (DL-041).
.claude/*
!.claude/agents/
